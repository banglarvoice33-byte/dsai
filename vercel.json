{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/api?__path=/healthz"
    },
    {
      "source": "/readyz",
      "destination": "/api?__path=/readyz"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__path=/api/:path*"
    }
  ]
}
