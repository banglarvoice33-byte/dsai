{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/api?__path=/healthz"
    },
    {
      "source": "/readyz",
      "destination": "/api?__path=/readyz"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__path=/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/scheduled/cleanupFileAssets",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/scheduled/syncMalwareBazaar",
      "schedule": "15 4 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
