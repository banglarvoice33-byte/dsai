# DSAI production environment template
# Copy to .env.production, replace every placeholder, then chmod 600.
# Never commit, upload, or paste the populated .env.production file.
NODE_ENV=production
PORT=3010
DSAI_APP_NAME=dsai-platform

# Mandatory core deployment values
DATABASE_URL=mysql://<database_user>:<database_password>@<database_host>:3306/<database_name>
JWT_SECRET=<generate-a-long-random-server-only-secret-at-least-32-characters>
VITE_APP_ID=<manus-oauth-application-id>
OAUTH_SERVER_URL=https://<manus-oauth-server-host>
VITE_OAUTH_PORTAL_URL=https://<manus-oauth-login-portal-host>

# Manus Built-in API. Optional by default; set DSAI_REQUIRE_FORGE=1 only when these values are configured.
BUILT_IN_FORGE_API_URL=https://<manus-built-in-api-host>
BUILT_IN_FORGE_API_KEY=<server-only-manus-built-in-api-key-at-least-32-characters>
DSAI_REQUIRE_FORGE=0

# Public production login protection. CAPTCHA remains fail-closed in production.
VITE_CAPTCHA_SITE_KEY=<turnstile-site-key-for-your-active-hostname>
CAPTCHA_SECRET_KEY=<turnstile-server-secret-at-least-32-characters>
CAPTCHA_ALLOWED_HOSTNAME=<active-production-hostname-without-https-or-path>
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_ENABLED=true

# Private Controlled Alpha only: no-CAPTCHA mode is bound to loopback and must not be public.
# Set these only for an intentionally private test process, never for public production.
DSAI_RUNTIME_MODE=production
DSAI_PRIVATE_ALPHA=false
DSAI_PRIVATE_ALPHA_BIND=127.0.0.1

# Optional provider connectors. Leave unset unless you are enabling the connector.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CAL_API_KEY=
# CRM_API_BASE_URL=https://<crm-api-host>/api
# CRM_API_KEY=
# MEDIA_WORKER_URL=https://<media-worker-host>
# MEDIA_WORKER_API_KEY=

# Operator-managed public web identity; verify DNS, TLS, and OAuth callbacks before launch.
# DSAI_TEST_HOST=dsai.banglarvoice24news.com
# DSAI_CONTACT_EMAIL=info@banglarvoice24news.com
