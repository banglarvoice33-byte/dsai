# Copy to .env.production, replace every placeholder, then set mode 0600.
# Do not commit or upload the populated .env.production file.
NODE_ENV=production
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
VITE_APP_ID=your-oauth-app-id
OAUTH_SERVER_URL=https://your-oauth-server
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal/login
VITE_APP_TITLE=DSAI

# Operator-managed public web identity; verify DNS and TLS before launch.
# DSAI_TEST_HOST=dsai.banglarvoice24news.com
# DSAI_CONTACT_EMAIL=info@banglarvoice24news.com

# Optional provider connectors; leave absent to keep safe fallback mode.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# CAPTCHA: required in production or when CAPTCHA_ENABLED=true. Use a provider public site key and server-only secret.
CAPTCHA_ENABLED=true
VITE_CAPTCHA_SITE_KEY=your-captcha-public-site-key
CAPTCHA_SECRET_KEY=your-captcha-server-secret
# CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# CAPTCHA_ALLOWED_HOSTNAME=dsai.banglarvoice24news.com
