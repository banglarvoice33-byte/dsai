# DSAI cloud configuration template — safe to commit; never place real secrets here.
# Production secrets belong in Vercel Production Environment Variables / Supabase Vault.
NODE_ENV=production

# Supabase project (public URL and publishable/anon key may be used by the browser).
SUPABASE_URL=https://wleytsrflhboyevhigiu.supabase.co
SUPABASE_ANON_KEY=<public-anon-or-publishable-key>

# Server-only credentials. NEVER prefix with VITE_ and NEVER expose to browser bundles.
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
DATABASE_URL=<server-only-postgres-connection-string-with-sslmode-require>

# Lead CRM — private Supabase Storage bucket and hard limits.
LEAD_ATTACHMENTS_BUCKET=lead-attachments
LEAD_ATTACHMENT_MAX_BYTES=10485760
LEAD_DAILY_CAP=20
LEAD_QUOTA_TIMEZONE=UTC
LEAD_QUALITY_GATE_ENABLED=true

# Optional server-side AI providers for verified enrichment only.
# If every configured provider fails, return a truthful unavailable/error response.
# Never fabricate a lead, contact detail, score, or AI-generated answer.
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# AI_PROVIDER_MODE=multi
# AI_TIMEOUT_MS=8000
# AI_MAX_OUTPUT_TOKENS=1000

# Existing file storage architecture remains R2 + Supabase Storage fallback.
# FILE_STORAGE_PROVIDER=auto
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=dsai-user-file
# R2_OBJECT_PREFIX=DSAI
